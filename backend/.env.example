# Campus AI Backend - Environment Configuration

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_ai?schema=public

# Institutional Policy
INSTITUTION_DOMAIN=yenepoya.edu.in

# Authentication (JWT & Cookies)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_super_secret_cookie_signing_key_32_chars

# NVIDIA NIM (AI Assistant)
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Storage
STORAGE_LOCAL_DIR=./uploads
MAX_FILE_SIZE_MB=25
